{
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "msteams": {
        "cardTypeId": "${$root.cardTypeId}"
    },
    "type": "AdaptiveCard",
    "speak": "Version 2.2 performance optimization",
    "backgroundImage": {
        "horizontalAlignment": "Right",
        "url": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ-L6qH4lmcuWaCTjzIV8j9CTUygrnZWC-Vvg&s"
    },
    "rtl": false,
    "body": [
        {
            "columns": [
                {
                    "width": "auto",
                    "type": "Column",
                    "backgroundImage": {
                        "horizontalAlignment": "Center"
                    },
                    "items": [
                        {
                            "type": "Image",
                            "size": "Large",
                            "url": "${$root.icon}"
                        }
                    ]
                },
                {
                    "width": "stretch",
                    "items": [
                        {
                            "size": "ExtraLarge",
                            "type": "TextBlock",
                            "text": "${$root.title}",
                            "color": "Warning",
                            "fontType": "Default",
                            "style": "default",
                            "weight": "Default",
                            "horizontalAlignment": "Left"
                        }
                    ],
                    "verticalContentAlignment": "Center",
                    "spacing": "Small",
                    "type": "Column"
                }
            ],
            "type": "ColumnSet",
            "spacing": "Large"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "50px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Clone",
                                    "wrap": true,
                                    "color": "Good"
                                }
                            ],
                            "verticalContentAlignment": "Center",
                            "minHeight": "30px",
                            "backgroundImage": {
                                "horizontalAlignment": "Right"
                            },
                            "rtl": true
                        },
                        {
                            "type": "Column",
                            "width": "300px",
                            "items": [
                                {
                                    "type": "Badge",
                                    "text": "${$root.clone}",
                                    "size": "ExtraLarge",
                                    "style": "Accent",
                                    "shape": "Rounded"
                                }
                            ],
                            "backgroundImage": {
                                "verticalAlignment": "Center"
                            },
                            "verticalContentAlignment": "Center",
                            "rtl": false,
                            "height": "stretch",
                            "horizontalAlignment": "Center"
                        }
                    ],
                    "spacing": "None"
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "50px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Nodo",
                                    "wrap": true,
                                    "color": "Good"
                                }
                            ],
                            "height": "stretch",
                            "verticalContentAlignment": "Center",
                            "rtl": true
                        },
                        {
                            "type": "Column",
                            "width": "300px",
                            "items": [
                                {
                                    "type": "Badge",
                                    "text": "${$root.nodo}",
                                    "size": "ExtraLarge",
                                    "style": "Good"
                                }
                            ],
                            "rtl": false,
                            "verticalContentAlignment": "Center"
                        }
                    ],
                    "spacing": "Small"
                }
            ],
            "spacing": "Medium"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "wrap": true,
                    "color": "Warning",
                    "size": "Large",
                    "style": "default",
                    "text": "${$root.descr}",
                    "spacing": "None"
                },
                {
                    "type": "Container",
                    "items": [
                        {
                            "type": "RichTextBlock",
                            "$when": "${$root.subdescr_visible}",
                            "inlines": [
                                {
                                "type": "TextRun",
                                "text": "${$root.subdescr}",
                                "fontType": "Monospace",
                                "size": "Small",
                                "isSubtle": true,
                                "wrap": false
                                }
                            ] 
                        }
                    ],
                    "$when": "${$root.subdescr_visible}",
                    "spacing": "${$root.subdescr_spacing}"
                }
            ],
            "showBorder": true,
            "roundedCorners": true,
            "style": "warning"
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "rtl": true,
                    "backgroundImage": {
                        "verticalAlignment": "Center"
                    },
                    "verticalContentAlignment": "Center",
                    "spacing": "ExtraSmall",
                    "items": [
                        {
                            "actions": [
                                {
                                    "title": "Elasticsearch",
                                    "type": "Action.OpenUrl",
                                    "iconUrl": "icon:LinkMultiple",
                                    "url": "${$root.link}",
                                    "style": "destructive"
                                }
                            ],
                            "type": "ActionSet",
                            "horizontalAlignment": "Right",
                            "spacing": "None"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${$root.date}",
                            "fontType": "Monospace",
                            "height": "stretch",
                            "wrap": true,
                            "horizontalAlignment": "Right",
                            "weight": "Lighter",
                            "size": "Small"
                        }
                    ],
                    "backgroundImage": {
                        "horizontalAlignment": "Right",
                        "verticalAlignment": "Bottom"
                    },
                    "verticalContentAlignment": "Top",
                    "horizontalAlignment": "Left",
                    "rtl": false,
                    "spacing": "ExtraSmall",
                    "showBorder": true
                }
            ],
            "spacing": "ExtraLarge"
        }
    ]
}