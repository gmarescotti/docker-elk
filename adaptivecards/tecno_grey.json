{
    "type": "AdaptiveCard",
    "speak": "Version 2.2 performance optimization",
    "body": [
        {
            "columns": [
                {
                    "width": "auto",
                    "items": [
                        {
                            "type": "Icon",
                            "name": "${$root.icon}",
                            "color": "Attention",
                            "size": "xxLarge",
                            "style": "Filled"
                        }
                    ],
                    "type": "Column",
                    "backgroundImage": {
                        "horizontalAlignment": "Center"
                    }
                },
                {
                    "width": "stretch",
                    "items": [
                        {
                            "size": "Large",
                            "wrap": true,
                            "type": "TextBlock",
                            "text": "${$root.raid_status}",
                            "color": "Light",
                            "fontType": "Monospace"
                        }
                    ],
                    "verticalContentAlignment": "Center",
                    "spacing": "Small",
                    "type": "Column"
                }
            ],
            "type": "ColumnSet",
            "spacing": "Large"
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "60px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Clone",
                                    "wrap": true,
                                    "color": "Light"
                                }
                            ],
                            "verticalContentAlignment": "Center"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${$root.clone}",
                                    "wrap": true,
                                    "size": "ExtraLarge",
                                    "style": "heading"
                                }
                            ]
                        }
                    ],
                    "spacing": "None"
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "60px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Nodo",
                                    "wrap": true,
                                    "color": "Light"
                                }
                            ],
                            "height": "stretch",
                            "verticalContentAlignment": "Center"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${$root.nodo}",
                                    "wrap": true,
                                    "size": "ExtraLarge",
                                    "style": "heading"
                                }
                            ]
                        }
                    ],
                    "spacing": "Small"
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "60px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Stato",
                                    "wrap": true,
                                    "color": "Light"
                                }
                            ],
                            "spacing": "ExtraSmall",
                            "verticalContentAlignment": "Center"
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${$root.stato}",
                                    "wrap": true,
                                    "color": "Warning",
                                    "size": "Large",
                                    "style": "default"
                                }
                            ]
                        }
                    ],
                    "spacing": "Small"
                },
                {
                    "type": "ColumnSet",
                    "columns": [
                        {
                            "type": "Column",
                            "width": "60px",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "Data",
                                    "wrap": true,
                                    "color": "Light"
                                }
                            ]
                        },
                        {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                                {
                                    "type": "TextBlock",
                                    "text": "${$root.data}",
                                    "wrap": true
                                }
                            ]
                        }
                    ],
                    "spacing": "Small"
                }
            ],
            "spacing": "None",
            "style": "emphasis",
            "roundedCorners": true,
            "showBorder": true
        },
        {
            "actions": [
                {
                    "title": "Elasticsearch",
                    "type": "Action.OpenUrl",
                    "iconUrl": "icon:LinkMultiple",
                    "url": "${$root.link}"
                }
            ],
            "type": "ActionSet",
            "targetWidth": "AtLeast:Narrow",
            "height": "stretch",
            "horizontalAlignment": "Left",
            "spacing": "Medium"
        }
    ],
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "backgroundImage": {
        "horizontalAlignment": "Right",
        "url": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR5aPAOfjIjwmFBuHVKWW30eIbYrdFbcCjwVVF5sIri1iKIG6vHMyJEa3krEE1qX_Qm_lw&usqp=CAU"
    }
}